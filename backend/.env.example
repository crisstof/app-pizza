# Copy to backend/.env and fill in. Never commit the real .env.

# Postgres from docker-compose.yml (docker compose up -d)
DATABASE_URL="postgresql://app_one:app_one_dev_password@localhost:5432/app_one?schema=public"

# API port
PORT=4000

# Signs the customer and staff session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Frontend origin allowed by CORS (cookies are sent cross-origin in dev)
FRONTEND_URL="http://localhost:5173"

# Shared password for the staff back-office (/pizzaiolo). Changing it logs
# every staff session out. Without it the staff login answers 503.
STAFF_PASSWORD=""

# Behind a reverse proxy (nginx, Traefik…): number of proxy hops to trust,
# so login lockouts see the real client IP instead of the proxy's.
# Leave empty when the backend is reached directly.
TRUST_PROXY=
