generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Client {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String?
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())

  orders Order[]
}

// category: "TOMATO" | "CREAM" | "SPECIAL" (base de la pizza, for menu filters)
// tags: any of "vegetarian" | "spicy" | "popular" | "new" (card badges)
model Pizza {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  priceCents  Int
  imageUrl    String?
  category    String   @default("TOMATO")
  tags        String[] @default([])
  // false = "Épuisée": still shown greyed on the menu, can't be ordered.
  available   Boolean  @default(true)
  // Set instead of deleting a pizza that past orders still reference.
  archivedAt  DateTime?

  orderItems OrderItem[]
}

// Singleton row (id = 1) holding the shop's service hours, edited from the
// staff back-office. Times are minutes since local midnight, on 30-min steps.
model ShopSettings {
  id             Int     @id @default(1)
  lunchOpen      Boolean @default(true)
  lunchStart     Int     @default(660)  // 11:00
  lunchEnd       Int     @default(840)  // 14:00
  dinnerOpen     Boolean @default(true)
  dinnerStart    Int     @default(1080) // 18:00
  dinnerEnd      Int     @default(1320) // 22:00
  slotCapacity   Int     @default(5)
  daysAhead      Int     @default(7)
  closedWeekdays Int[]   @default([])   // 0 = Sunday … 6 = Saturday
}

// Exceptional closure (holiday…), as a local "YYYY-MM-DD" date.
model ClosedDay {
  date   String  @id
  reason String?
}

// A bookable slot at the pizzeria. capacity/reserved lets the shop
// cap how many orders can be prepared in the same window.
model TimeSlot {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int
  reserved  Int      @default(0)
  // Closed by staff (rush, holiday, hours changed): hidden from customers,
  // existing orders stay valid.
  closed    Boolean  @default(false)

  orders Order[]

  @@unique([startsAt])
}

model Order {
  id          String      @id @default(cuid())
  client      Client      @relation(fields: [clientId], references: [id])
  clientId    String
  timeSlot    TimeSlot    @relation(fields: [timeSlotId], references: [id])
  timeSlotId  String
  status        OrderStatus @default(PENDING)
  totalCents    Int
  discountCents Int         @default(0)
  pointsEarned  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // When each status was reached (null = not yet), for the customer timeline.
  confirmedAt DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  pickedUpAt  DateTime?
  cancelledAt DateTime?

  // Pizzaiolo's "ready in N minutes" estimate: etaSetAt is when it was given,
  // so the tracking page can draw progress from etaSetAt to estimatedReadyAt.
  etaSetAt         DateTime?
  estimatedReadyAt DateTime?

  items   OrderItem[]
  payment Payment?
}

model OrderItem {
  id            String @id @default(cuid())
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  pizza         Pizza  @relation(fields: [pizzaId], references: [id])
  pizzaId       String
  quantity      Int
  unitPriceCents Int
}

model Payment {
  id              String        @id @default(cuid())
  order           Order         @relation(fields: [orderId], references: [id])
  orderId         String        @unique
  stripePaymentId String?
  amountCents     Int
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
}
