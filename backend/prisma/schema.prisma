generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Client {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String?
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())

  orders Order[]
}

// category: "TOMATO" | "CREAM" | "SPECIAL" (base de la pizza, for menu filters)
// tags: any of "vegetarian" | "spicy" | "popular" | "new" (card badges)
model Pizza {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  priceCents  Int
  imageUrl    String?
  category    String   @default("TOMATO")
  tags        String[] @default([])
  available   Boolean  @default(true)

  orderItems OrderItem[]
}

// A bookable slot at the pizzeria. capacity/reserved lets the shop
// cap how many orders can be prepared in the same window.
model TimeSlot {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int
  reserved  Int      @default(0)

  orders Order[]

  @@unique([startsAt])
}

model Order {
  id          String      @id @default(cuid())
  client      Client      @relation(fields: [clientId], references: [id])
  clientId    String
  timeSlot    TimeSlot    @relation(fields: [timeSlotId], references: [id])
  timeSlotId  String
  status        OrderStatus @default(PENDING)
  totalCents    Int
  discountCents Int         @default(0)
  pointsEarned  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items   OrderItem[]
  payment Payment?
}

model OrderItem {
  id            String @id @default(cuid())
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  pizza         Pizza  @relation(fields: [pizzaId], references: [id])
  pizzaId       String
  quantity      Int
  unitPriceCents Int
}

model Payment {
  id              String        @id @default(cuid())
  order           Order         @relation(fields: [orderId], references: [id])
  orderId         String        @unique
  stripePaymentId String?
  amountCents     Int
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
}
